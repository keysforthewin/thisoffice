# Copy to .env and adjust as needed. Every value is optional — the defaults
# shown here are what you get with no .env at all.

# --- docker compose (host port mappings) ---
# Host ports the containers are published on. Change these if 4680/5173 are
# already taken on your machine; the in-container ports stay fixed.
SERVER_PORT=4680
WEB_PORT=5173

# --- server ---
# Where Claude Code transcripts live. The server tails *.jsonl under this dir.
# Docker sets this to /claude/projects via the compose file's ~/.claude mount.
CLAUDE_PROJECTS_DIR=~/.claude/projects

# Set to 1 to make the transcript watcher poll instead of using fs events.
# Required in Docker (bind mounts don't deliver inotify events); leave unset
# when running locally.
#WATCH_POLL=1

# --- web (Vite dev server) ---
# Backend the dev server proxies /api and the WebSocket to. Docker sets this
# to http://server:4680; locally the default is fine.
#VITE_PROXY_TARGET=http://localhost:4680

# --- scripts ---
# Source directory for `npm run promote` (defaults to ./data). The Docker
# setup needs this because data/ is root-owned on the host.
#DATA_DIR=./data
