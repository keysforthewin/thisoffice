{
  "name": "thisoffice",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "catalog": "node scripts/generate-catalog.mjs",
    "vista": "node scripts/measure-vista.mjs",
    "test": "vitest run",
    "check-rig": "tsx scripts/check-rig.ts",
    "promote": "tsx scripts/promote-character.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "three": "^0.185.1",
    "vitest": "^3.0.0"
  }
}
